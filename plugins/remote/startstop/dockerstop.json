{
    "opDesc": "停止Docker容器",
    "opType": "target",
    "typeName": "START_STOP",
    "riskName": "LOW",
    "interpreter": "perl",
    "defaultProfile": "docker-args",
    "description": "在远程OS上停止已存在的Docker容器",
    "enabled": 1,
    "option": [
        {
            "opt": "name",
            "name": "容器名",
            "help": "容器名称",
            "type": "text",
            "required": "true",
            "validate": "",
            "defaultValue": "${SYS_NAME}-${MODULE_NAME}"
        },
        {
            "opt": "timeout",
            "name": "超时时间",
            "help": "停止超时时间，单位秒",
            "type": "text",
            "required": "true",
            "validate": "",
            "defaultValue": "10"
        }
    ],
    "argument": {},
    "output": []
}