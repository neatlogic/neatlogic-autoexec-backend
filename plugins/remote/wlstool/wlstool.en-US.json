                "dataList": [
                    {
                        "text": "No",
                        "value": "0"
                    },
                    {
                        "text": "Yes",
                        "value": "1"
                    }
                ]
            },
            "defaultValue": "0"
        },
        {
            "opt": "need_deploy",
            "name": "New Application Autodeployment",
            "help": "Whether or not to call the was interface deployment application, corresponding to dmgr, only to deploy on one machine, and all other nodes will automatically synchronize",
            "type": "select",
            "required": "true",
            "dataSource": {
                "dataList": [
                    {
                        "text": "No",
                        "value": "0"
                    },
                    {
                        "text": "Yes",
                        "value": "1"
                    }
                ]
            },
            "defaultValue": "0"
        },
        {
            "opt": "servername",
            "name": "Server Name",
            "help": "Server's name.",
            "type": "text",
            "required": "true",
            "defaultValue": ""
        },
        {
            "opt": "appname",
            "name": "Deployment",
            "help": "Apply a deployment name, deploy an interface with a corresponding deployment 'name 'value",
            "type": "text",
            "required": "true",
            "defaultValue": "demo_war"
        },
        {
            "opt": "appfile",
            "name": "Package Path",
            "help": "Package path, transit directory for updating the current directory to webcast installation path",
            "type": "text",
            "required": "true",
            "defaultValue": "/tmp/demo.war"
        },
        {
            "opt": "source-path",
            "name": "Install Path",
            "help": "The path to the directory or package specified during the installation of the webcast console application",
            "type": "text",
            "required": "true",
            "defaultValue": "/app/systems/test/sample/sample.war"
        },
        {
            "opt": "target",
            "name": "Target for deployment",
            "help": "Apply the deployed target webcast instance name or Cluster name, deploy an interface in the deployed location, apply the corresponding deployment \"target\" value",
            "type": "text",
            "required": "true",
            "defaultValue": "myserver"
        },
        {
            "opt": "staging-mode",
            "name": "Staging Mode",
            "help": "Deployment mode, nostage for Managed Server will not download applications from admin servicer, but will need to upload applications on all Server directories, suggesting nostage mode, or download applications from Admin Server for every restart",
            "type": "select",
            "required": "true",
            "dataSource": {
                "dataList": [
                    {
                        "text": "nostage",
                        "value": "nostage"
                    },
                    {
                        "text": "stage",
                        "value": "stage"
                    }
                ]
            },
            "defaultValue": "nostage"
        },
        {
            "opt": "checkurl",
            "name": "Detect URL",
            "help": "Apply URL access, take note of ports, e.g. http://127.0.0.1:9082/demo/",
            "type": "text",
            "required": "true",
            "defaultValue": ""
        },
        {
            "opt": "custom_stdoutfiles",
            "name": "Clientization log path",
            "help": "You can set multiple paths, separated by commas, the first path is the standard output file path",
            "type": "text",
            "required": "false",
            "defaultValue": ""
        },
        {
            "opt": "max_logsize",
            "name": "Log File Size",
            "help": "Console output log, maximum size of single file (M), default of 2048M",
            "type": "text",
            "required": "true",
            "defaultValue": "2048"
        },
        {
            "opt": "max_logfiles",
            "name": "Maximum log number",
            "help": "Maximum number of files in the console output log, more than will automatically clean up",
            "type": "text",
            "required": "true",
            "defaultValue": "123"
        },
        {
            "opt": "max_logdays",
            "name": "Maximum number of days to keep a log",
            "help": "Maximum number of days left in the console output log, more than will automatically clean up",
            "type": "text",
            "required": "true",
            "defaultValue": "93"
        },
        {
            "opt": "USER_MEM_ARGS",
            "name": "JAVA Memory Parameters",
            "help": "JAVA memory parameters for setting memory parameters, e.g. -Xms256m -Xmx1024m -XX: MaxPermSize=256m",
            "type": "text",
            "required": "false",
            "defaultValue": ""
        },
        {
            "opt": "JAVA_EXT_OPTS",
            "name": "JAVA Parameters",
            "help": "JAVA Extension Parameters for setting JAVA Extension Parameters",
            "type": "text",
            "required": "true",
            "defaultValue": "-Djava.security.egd=file:/dev/./urandom"
        }
