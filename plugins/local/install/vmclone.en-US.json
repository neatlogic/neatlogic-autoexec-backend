{
    "opDesc": "A clone virtual machine.",
    "opType": "runner",
    "typeName": "INSTALL",
    "riskName": "HIGH",
    "interpreter": "python",
    "defaultProfile": null,
    "description": "Vshpere-based virtual machines (virtual machine templates or cloned virtual machines must be installed first)",
    "option": [
        {
            "opt": "ip",
            "name": "ip",
            "help": "vsphere Management IP",
            "type": "text",
            "required": "false",
            "validate": [
                "ip"
            ],
            "defaultValue": ""
        },
        {
            "opt": "user",
            "name": "user",
            "help": "vsphere Manage Users",
            "type": "text",
            "required": "false",
            "validate": "",
            "defaultValue": ""
        },
        {
            "opt": "password",
            "name": "password",
            "help": "vsphere manage login user password",
            "type": "password",
            "required": "false",
            "validate": "",
            "defaultValue": ""
        },
        {
            "opt": "port",
            "name": "port",
            "help": "vsphere manage port",
            "type": "text",
            "required": "false",
            "validate": [
                "integer_p"
            ],
            "defaultValue": "443"
        },
        {
            "opt": "datacenter_name",
            "name": "Datacenter Name",
            "help": "Name of the vshere datacenter data centre",
            "type": "text",
            "required": "true",
            "validate": "",
            "defaultValue": ""
        },
        {
            "opt": "cluster_name",
            "name": "Cluster name",
            "help": "Name of vshere cluster cluster",
            "type": "text",
            "required": "true",
            "validate": "",
            "defaultValue": ""
        },
        {
            "opt": "datastore_name",
            "name": "Datastore name",
            "help": "Vsphere datastore storage name",
            "type": "text",
            "required": "false",
            "validate": "",
            "defaultValue": ""
        },
        {
            "opt": "template_name",
            "name": "Template Name",
            "help": "Name of the vsphere template",
            "type": "text",
            "required": "true",
            "validate": "",
            "defaultValue": ""
        },
        {
            "opt": "vm_folder",
            "name": "Store Directory",
            "help": "New virtual repository directory for vsphere, which does not exist. Examples:",
            "type": "text",
            "required": "true",
            "validate": "",
            "defaultValue": ""
        },
        {
            "opt": "host_name",
            "name": "Server Name",
            "help": "Name of the vsphere server hardware",
            "type": "text",
            "required": "true",
            "validate": "",
            "defaultValue": ""
        },
        {
            "opt": "vm_name",
            "name": "Name",
            "help": "Virtual machine name generated by cloning",
            "type": "text",
            "required": "true",
            "validate": "",
            "defaultValue": ""
        },
        {
            "opt": "vm_ip",
            "name": "IP",
            "help": "Virtual machine created by cloning IP",
            "type": "text",
            "required": "true",
            "validate": [
                "ip"
            ],
            "defaultValue": ""
        },
        {
            "opt": "netmask",
            "name": "Mask",
            "help": "A clone-generated virtual machine mask",
            "type": "text",
            "required": "true",
            "validate": "",
            "defaultValue": ""
        },
        {
            "opt": "gateway",
            "name": "Gateway",
            "help": "Virtual machine gateway generated by cloning",
            "type": "text",
            "required": "true",
            "validate": "",
            "defaultValue": ""
        },
        {
            "opt": "dns",
            "name": "DNS",
            "help": "A cloned virtual machine, DNS, with several commas separated. For example: 1.1.1.1, 2.2.2.2",
            "type": "text",
            "required": "true",
            "validate": "",
            "defaultValue": ""
        },
        {
            "opt": "hostname",
            "name": "hostname",
            "help": "Name of the virtual machine host generated by cloning",
            "type": "text",
            "required": "true",
            "validate": [
                "enchar"
            ],
            "defaultValue": ""
        },
        {
            "opt": "cup_num",
            "name": "cpu number",
            "help": "Number of virtual machine hosts generated by cloning CPUs",
            "type": "text",
            "required": "true",
            "validate": [
                "integer_p"
            ],
            "defaultValue": ""
        },
        {
            "opt": "memory",
            "name": "Memory (GB)",
            "help": "Memory size of a cloned virtual machine host",
            "type": "text",
            "required": "true",
            "validate": [
                "integer_p"
            ],
            "defaultValue": ""
        },
        {
            "opt": "disk_size",
            "name": "Disk (GB)",
            "help": "The size of the cloned virtual host disk",
            "type": "text",
            "required": "true",
            "validate": [
                "integer_p"
            ],
            "defaultValue": ""
        },
        {
            "opt": "disk_type",
            "name": "Disk Type",
            "help": "Type of virtual machine host disk generated by cloning",
            "type": "select",
            "required": "true",
            "validate": "",
            "dataSource": {
                "dataList": [
                    {
                        "text": "Thin Provisioning",
                        "value": "thin"
                    },
                    {
                        "text": "Thick Provisioning with Lazy Zeroing",
                        "value": "zeroed thick"
                    },
                    {
                        "text": "Thick Provisioning with Eager Zeroing",
                        "value": "eager zeroed thick"
                    }
                ]
            },
            "defaultValue": ""
        },
        {
            "opt": "verbose",
            "name": "Show Details",
            "help": "Print Detailed Log",
            "type": "select",
            "required": "false",
            "validate": "",
            "dataSource": {
                "dataList": [
                    {
                        "text": "No",
                        "value": "0"
                    },
                    {
                        "text": "Yes",
                        "value": "1"
                    }
                ]
            },
            "defaultValue": "0"
        }
    ],
    "output": [
        {
            "opt": "selectNodeList",
            "name": "Execute Nodes",
            "help": "Dynamic nodes generated from cloning",
            "type": "node"
        }
    ]
}
