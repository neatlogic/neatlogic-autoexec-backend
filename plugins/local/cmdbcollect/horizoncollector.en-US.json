            "type": "text",
            "required": "yes",
            "validate": "",
            "defaultValue": "443"
        },
        {
            "opt": "username",
            "name": "User",
            "help": "Accessed users, default users using nodes",
            "type": "text",
            "required": "yes",
            "validate": "",
            "defaultValue": ""
        },
        {
            "opt": "password",
            "name": "Password",
            "help": "User password for access, default password for node",
            "type": "password",
            "required": "yes",
            "validate": "",
            "defaultValue": ""
        },
        {
            "opt": "version",
