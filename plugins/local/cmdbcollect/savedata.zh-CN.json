{
    "opDesc": "CMDB采集数据保存",
    "opType": "runner_target",
    "typeName": "CMDB",
    "riskName": "LOW",
    "interpreter": "python",
    "defaultProfile": null,
    "description": "对采集插件生成的数据存储到DB",
    "option": [
    {
        "opt": "ttltime",
        "name": "数据老化清理时间",
        "help": "采集数据多少天内无更新自动清理的时间，单位为天",
        "type": "text",
        "required": "false",
        "validate": ["number"],
        "defaultValue": "30"
    },
    {
        "opt": "batchtag",
        "name": "批次号",
        "help": "保存到采集数据中的批次号，用于标记当次采集的数据",
        "type": "text",
        "required": "false",
        "validate": "",
        "defaultValue": ""
    }],
    "argument": {
        "name": "自定义采集工具名",
        "help": "进行CMDB采集的自定义工具名，支持输入多个",
        "type": "text",
        "count": 0,
        "isConst": "false",
        "defaultValue": "",
        "required": "false",
        "validate": ""
    },
    "output": [
        {
            "opt": "collections",
            "name": "数据集合名称",
            "help": "涉及数据保存的数据集合的Map, 格式：{'COLLECT_INS':1,'COLLECT_OS':1}",
            "type": "json"
        },
        {
            "opt": "objTypesMap",
            "name": "OBJ_TYPE名称",
            "help": "涉及的OBJ_TYPE名称数据集合的Map, 格式:{'OS:Linux':1, 'DBINS:Mysql':1}",
            "type": "json"
        }
    ]
}
