{
    "opDesc": "Save CMDB Collection Data",
    "opType": "runner_target",
    "typeName": "CMDB",
    "riskName": "LOW",
    "interpreter": "python",
    "defaultProfile": null,
    "description": "Storage of data generated by collecting plugins to DB",
    "option": [
        {
            "opt": "ttltime",
            "name": "Data ageing cleanup time",
            "help": "No update of automatic cleanup time, in days of data collection",
            "type": "text",
            "required": "false",
            "validate": [
                "number"
            ],
            "defaultValue": "30"
        },
        {
            "opt": "batchtag",
            "name": "Batch Number",
            "help": "Saves the batch number in the collected data for tagging the data collected at the time",
            "type": "text",
            "required": "false",
            "validate": "",
            "defaultValue": ""
        }
    ],
    "argument": {
        "name": "Custom Collection Tool Name",
        "help": "A custom toolname for conducting a CMDB collection, which supports input of multiple",
        "type": "text",
        "count": 0,
        "isConst": "false",
        "defaultValue": "",
        "required": "false",
        "validate": ""
    },
    "output": [
        {
            "opt": "collections",
            "name": "Data set name",
            "help": "Map, Format: { 'COLLECT_INS' 1, 'COLLECT_OS':",
            "type": "json"
        },
        {
            "opt": "objTypesMap",
            "name": "OBJ_TYPE Name",
            "help": "Map, format: {'OS:Linux': 1, `DBINS:Mysql':m)",
            "type": "json"
        }
    ]
}
