{
    "opName": "存储CMDB采集",
    "opType": "runner_target",
    "typeName": "CMDB",
    "riskName": "LOW",
    "interpreter": "perl",
    "defaultProfile": null,
    "description": "采集存储设备信息,支持IBM、NetApp、EMC、Huawei等",
    "option": [
        {
            "opt": "community",
            "name": "默认团体字",
            "help": "当在节点信息中没有密码是，使用此默认SNMP团体字",
            "type": "password",
            "required": "false",
            "validate": "",
            "defaultValue": "public"
        },
        {
            "opt": "sshaccount",
            "name": "SSH账号",
            "help": "采用SSH协议账号补充采集",
            "type": "account",
            "required": "false",
            "validate": "",
            "defaultValue": ""
        },
        {
            "opt": "timeout",
            "name": "超时时间",
            "help": "查询超时时间，单位秒",
            "type": "text",
            "required": "true",
            "validate": "",
            "defaultValue": "10"
        },
        {
            "opt": "type",
            "name": "存储类别",
            "help": "存储的类别型号",
            "type": "select",
            "required": "true",
            "validate": "",
            "dataSource": {
                "dataList": [
                    {
                        "text": "EMC_Vnx",
                        "value": "EMC_Vnx"
                    },
                    {
                        "text": "EMC_Vplex",
                        "value": "EMC_Vplex"
                    },
                    {
                        "text": "EMC_RPA",
                        "value": "EMC_RPA"
                    },
                    {
                        "text": "HP_3PAR",
                        "value": "HP_3PAR"
                    },
                    {
                        "text": "HDS_AMS",
                        "value": "HDS_AMS"
                    },
                    {
                        "text": "HDS_VSP",
                        "value": "HDS_VSP"
                    },
                    {
                        "text": "Huawei",
                        "value": "HuaWei"
                    },
                    {
                        "text": "Huawei_OceanStor",
                        "value": "Huawei_OceanStor"
                    },
                    {
                        "text": "IBM_DS",
                        "value": "IBM_DS"
                    },
                    {
                        "text": "IBM_F900",
                        "value": "IBM_F900"
                    },
		    {
                        "text": "IBM_FS9200",
                        "value": "IBM_FS9200"
                    },
                    {
                        "text": "IBM_Flash",
                        "value": "IBM_Flash"
                    },
                    {
                        "text": "IBM_SVC",
                        "value": "IBM_SVC"
                    },
                    {
                        "text": "IBM_V7000",
                        "value": "IBM_V7000"
                    },
                    {
                        "text": "NetApp",
                        "value": "NetApp"
                    },
                    {
                        "text": "FUJITSU/浪潮OEM",
                        "value": "FUJITSU"
                    }
                ]
            },
            "defaultValue": ""
        },
        {
            "opt": "inspect",
            "name": "巡检检查",
            "help": "采集更详细的巡检数据",
            "type": "select",
            "required": "true",
            "validate": "",
            "dataSource": {
                "dataList": [
                    {
                        "text": "不采集",
                        "value": "0"
                    },
                    {
                        "text": "采集",
                        "value": "1"
                    }
                ]
            },
            "defaultValue": "0"
        },
        {
            "opt": "verbose",
            "name": "回显结果数据",
            "help": "回显采集到的数据",
            "type": "select",
            "required": "true",
            "validate": "",
            "dataSource": {
                "dataList": [
                    {
                        "text": "不回显",
                        "value": "0"
                    },
                    {
                        "text": "回显",
                        "value": "1"
                    }
                ]
            },
            "defaultValue": "0"
        }
    ],
    "output": [
        {
            "opt": "DATA",
            "name": "JSON数据",
            "help": "采集到的数据",
            "type": "json"
