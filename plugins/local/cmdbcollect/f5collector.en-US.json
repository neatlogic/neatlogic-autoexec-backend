{
    "opName": "F5CMDB采集",
    "opType": "runner_target",
    "typeName": "CMDB",
    "riskName": "LOW",
    "interpreter": "perl",
    "defaultProfile": null,
    "description": "Use SNMP to collect F5 VS, POOL, MEMBER information",
    "option": [
        {
            "opt": "community",
            "name": "Default group word",
            "help": "Use this default SNMP group word when there is no password in the node message",
            "type": "password",
            "required": "false",
            "validate": "",
            "defaultValue": "public"
        },
        {
            "opt": "timeout",
            "name": "Timeout",
            "help": "Single SNMP query timeout, in seconds",
            "type": "text",
            "required": "true",
            "validate": "",
            "defaultValue": "10"
        },
        {
            "opt": "verbose",
            "name": "Echoed Result Data",
            "help": "Echo Collected Data",
            "type": "select",
            "required": "true",
            "validate": "",
            "dataSource": {
                "dataList": [
                    {
                        "text": "Do Not Echo",
                        "value": "0"
                    },
                    {
                        "text": "Echo",
                        "value": "1"
                    }
                ]
            },
            "defaultValue": "0"
        }
    ],
    "output": [
        {
            "opt": "DATA",
            "name": "JSON data",
            "help": "Data collected",
            "type": "json"
        }
    ]
}
