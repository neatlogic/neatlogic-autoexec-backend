{
    "opName": "防火墙信息采集",
    "opType": "runner_target",
    "typeName": "CMDB",
    "riskName": "LOW",
    "interpreter": "perl",
    "defaultProfile": null,
    "description": "Collecting firewall equipment to support Huawei, CheckPoint, HillStone, TopSec, etc.",
    "option": [
        {
            "opt": "community",
            "name": "Default group word",
            "help": "Use this default SNMP group word when there is no password in the node message",
            "type": "password",
            "required": "false",
            "validate": "",
            "defaultValue": "public"
        },
        {
            "opt": "sshaccount",
            "name": "SSH Account",
            "help": "Supplementary collection using SSH protocol account number",
            "type": "account",
            "required": "false",
            "validate": "",
            "defaultValue": ""
        },
        {
            "opt": "timeout",
            "name": "Timeout",
            "help": "Query timeout, in seconds",
            "type": "text",
            "required": "true",
            "validate": "",
            "defaultValue": "10"
        },
        {
            "opt": "type",
            "name": "Firewall category",
            "help": "Type model of firewall",
            "type": "select",
            "required": "true",
            "validate": "",
            "dataSource": {
                "dataList": [
                    {
                        "text": "AutoSelect",
                        "value": "auto"
                    },
                    {
                        "text": "Huawei",
                        "value": "Huawei"
                    },
                    {
                        "text": "CheckPoint",
                        "value": "CheckPoint"
                    },
                    {
                        "text": "Juniper",
                        "value": "Juniper"
                    },
                    {
                        "text": "Hillstone",
                        "value": "HillStone"
                    },
                    {
                        "text": "Topsec",
                        "value": "TopSec"
                    }
                ]
            },
            "defaultValue": "auto"
        },
        {
            "opt": "verbose",
            "name": "Echoed Result Data",
            "help": "Echo Collected Data",
            "type": "select",
            "required": "true",
            "validate": "",
            "dataSource": {
                "dataList": [
                    {
                        "text": "Do Not Echo",
                        "value": "0"
                    },
                    {
                        "text": "Echo",
                        "value": "1"
                    }
                ]
            },
            "defaultValue": "0"
        }
    ],
    "output": [
        {
            "opt": "DATA",
            "name": "JSON data",
            "help": "Data collected",
            "type": "json"
        }
    ]
}
