{
    "opName": "光交信息采集",
    "opType": "runner_target",
    "typeName": "CMDB",
    "riskName": "LOW",
    "interpreter": "perl",
    "defaultProfile": null,
    "description": "SNMP collects information on photovoltaic equipment in support of Brocade-based types",
    "option": [
        {
            "opt": "community",
            "name": "Default group word",
            "help": "Use this default SNMP group word when there is no password in the node message",
            "type": "password",
            "required": "false",
            "validate": "",
            "defaultValue": "public"
        },
        {
            "opt": "sshaccount",
            "name": "SSH Account",
            "help": "Supplementary collection using SSH protocol account number",
            "type": "account",
            "required": "false",
            "validate": "",
            "defaultValue": ""
        },
        {
            "opt": "timeout",
            "name": "Timeout",
            "help": "Query timeout, in seconds",
            "type": "text",
            "required": "true",
            "validate": "",
            "defaultValue": "10"
        },
        {
            "opt": "type",
            "name": "Fibre Channel Switch Category",
            "help": "Fibre Channel Switch Model",
            "type": "select",
            "required": "true",
            "validate": "",
            "dataSource": {
                "dataList": [
                    {
                        "text": "AutoSelect",
                        "value": "auto"
                    },
                    {
                        "text": "Brocade",
                        "value": "Brocade"
                    },
                    {
                        "text": "IBM",
                        "value": "IBM"
                    },
                    {
                        "text": "EMC",
                        "value": "EMC"
                    },
                    {
                        "text": "HP",
                        "value": "HP"
                    },
                    {
                        "text": "Huawei",
                        "value": "Huawei"
                    }
                ]
            },
            "defaultValue": "auto"
        },
        {
            "opt": "inspect",
            "name": "Inspection",
            "help": "Collect more detailed inspection data",
            "type": "select",
            "required": "true",
            "validate": "",
            "dataSource": {
                "dataList": [
                    {
                        "text": "Do Not Collect",
                        "value": "0"
                    },
                    {
                        "text": "Collection",
                        "value": "1"
                    }
                ]
            },
            "defaultValue": "0"
        },
        {
            "opt": "verbose",
            "name": "Echoed Result Data",
            "help": "Echo Collected Data",
            "type": "select",
            "required": "true",
            "validate": "",
            "dataSource": {
                "dataList": [
                    {
                        "text": "Do Not Echo",
                        "value": "0"
                    },
                    {
                        "text": "Echo",
                        "value": "1"
                    }
                ]
            },
            "defaultValue": "0"
        }
    ],
    "output": [
        {
            "opt": "DATA",
            "name": "JSON data",
            "help": "Data collected",
            "type": "json"
        }
    ]
}
