{
    "opDesc": "Check JSON data",
    "opType": "runner",
    "typeName": "BASIC",
    "riskName": "LOW",
    "interpreter": "perl",
    "defaultProfile": null,
    "description": "Filters JSON data matching according to the configuration rules, and if it does not meet the rules, wrongly",
    "option": [
        {
            "opt": "data",
            "name": "JSON data",
            "help": "JSON data required to enforce inspection rules",
            "type": "json",
            "required": "true",
            "validate": "",
            "defaultValue": ""
        },
        {
            "opt": "charset",
            "name": "Character Set",
            "help": "Character set for JSON data",
            "type": "select",
            "required": "true",
            "validate": "",
            "dataSource": {
                "dataList": [
                    {
                        "text": "UTF-8",
                        "value": "UTF-8"
                    },
                    {
                        "text": "GB18030",
                        "value": "GB18030"
                    }
                ]
            },
            "defaultValue": "UTF-8"
        },
        {
            "opt": "disfields",
            "name": "Show Fields",
            "help": "Multi-field commas separated, multi-layer objects connected by point, e.g. applicationModels.applicationstatus",
            "type": "text",
            "required": "false",
            "validate": "",
            "defaultValue": ""
        },
        {
            "opt": "filter",
            "name": "Filter Conditions",
            "help": "Object filtering, for example: [applicationModels.applicationName] = 'ATMP_Subscriber' and [managePath] = 'ATMP'",
            "type": "text",
            "required": "false",
            "validate": "",
            "defaultValue": ""
        },
        {
            "opt": "chkdsl",
            "name": "Check DSL",
            "help": "Check DSL, for example: [application Models.application status] = = '1'",
            "type": "text",
            "required": "false",
            "validate": "",
            "defaultValue": ""
        }
    ],
    "output": []
}
