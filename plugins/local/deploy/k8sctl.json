{
    "opDesc": "K8S应用部署工具",
    "opType": "runner",
    "typeName": "DEPLOY",
    "riskName": "LOW",
    "interpreter": "perl",
    "defaultProfile": "k8s-args",
    "description": "K8S应用的部署",
    "enabled": 1,
    "option": [
        {
            "opt": "host",
            "name": "管理IP或域名",
            "help": "K8S 管理IP或域名，例如：192.168.99.100",
            "type": "text",
            "required": "true",
            "validate": "",
            "defaultValue": ""
        },
        {
            "opt": "apiport",
            "name": "API端口",
            "help": "K8S API端口，例如:8443",
            "type": "text",
            "required": "true",
            "validate": "",
            "defaultValue": "8443"
        },
        {
            "opt": "token",
            "name": "验证TOKEN",
            "help": "K8S API服务的验证TOKEN",
            "type": "password",
            "required": "true",
            "validate": "",
            "defaultValue": "${global:k8s.token}"
        },
        {
            "opt": "action",
            "name": "动作",
            "help": "执行的动作",
            "type": "select",
            "required": "true",
            "validate": "",
            "dataSource": {
                "dataList": [
                    {
                        "text": "更新",
                        "value": "deploy"
                    },
                    {
                        "text": "回滚",
                        "value": "rollback"
                    },
                    {
                        "text": "重启",
                        "value": "restart"
                    },
                    {
                        "text": "启动",
                        "value": "start"
                    },
                    {
                        "text": "停止",
                        "value": "stop"
                    }
                ]
            },
            "defaultValue": "patch"
        },
        {
            "opt": "autocreate",
            "name": "自动创建",
            "help": "如资源对象不存在，则自动创建",
            "type": "select",
            "required": "true",
            "validate": "",
            "dataSource": {
                "dataList": [
                    {
                        "text": "否",
                        "value": "0"
                    },
                    {
                        "text": "是",
                        "value": "1"
                    }
                ]
            },
            "defaultValue": "0"
        },
        {
            "opt": "dryrun",
            "name": "dryRun",
            "help": "干跑验证",
            "type": "select",
            "required": "true",
            "validate": "",
            "dataSource": {
                "dataList": [
                    {
                        "text": "否",
                        "value": "0"
                    },
                    {
                        "text": "是",
                        "value": "1"
                    }
                ]
            },
            "defaultValue": "0"
        },
        {
            "opt": "healthcheckneeded",
            "name": "需健康检查",
            "help": "检查deployment配置中是否配置了健康检查",
            "type": "select",
            "required": "true",
            "validate": "",
            "dataSource": {
                "dataList": [
                    {
                        "text": "是",
                        "value": "1"
                    },
                    {
                        "text": "否",
                        "value": "0"
                    }
                ]
            },
            "defaultValue": "1"
        },
        {
            "opt": "dplyyamlfile",
            "name": "Deploy配置文件",
            "help": "Yaml配置文件在制品库中的相对路径，如提供了文件，则下面其他属性名非必须",
            "type": "text",
            "required": "false",
            "validate": "",
            "defaultValue": "deployment.yaml"
        },
        {
            "opt": "namespace",
            "name": "命名空间",
            "help": "应用所在的K8S命名空间",
            "type": "text",
            "required": "false",
            "validate": "",
            "defaultValue": ""
        },
        {
            "opt": "deployment",
            "name": "部署名",
            "help": "K8S中定义的deployment名称",
            "type": "text",
            "required": "false",
            "validate": "",
            "defaultValue": ""
        },
        {
            "opt": "timeout",
            "name": "超时时间",
            "help": "超时时间,循环检查k8s滚动更新pods状态的最大超时时间",
            "type": "text",
            "required": "true",
            "validate": ["integer_p"],
            "defaultValue": "120"
        },
        {
            "opt": "imagelist",
            "name": "镜像列表",
            "help": "镜像列表，支持多镜像，一行一个，会自动转小写",
            "type": "textarea",
            "required": "false",
            "validate": "",
            "defaultValue": "repository/${SYS_NAME}/${MODULE_NAME}:${ENV_NAME}-${VERSION}"
        }
    ],
    "output": [
        {
            "opt": "k8s_data",
            "name": "滚动更新数据",
            "help": "滚动更新数据",
            "type": "text"
        }
    ]
}