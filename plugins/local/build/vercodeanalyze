#!/usr/bin/perl
use strict;
use FindBin;

use Getopt::Long;
use File::Copy;
use File::Path;
use Cwd;
use JSON;

use DeployUtils;
use DeployLock;
use VerGet;
use ServerAdapter;

sub usage {
    my $pname = $FindBin::Script;

    print("usage: $pname [-v 0|1] [--envpath EnvPath] [--lang LANG] \n");
    print("              [--version VERSION]\n");
    print("              [--user USERNAME] [--password PASSWORD]\n");
    print("\n");
    print("optional arguments:\n");
    print("  --envpath: optionnal, name path for application\n");
    print("  --lang:    optionnal, LANG\n");
    print("  --version: optionnal, Version number\n");
    print("  --buildno:   Build number\n");

    exit(1);
}

sub main {
    my ( $isHelp, $isVerbose, $lang, $repoType, $envPath, $version, $buildNo, $startPath );
    my ( $userName, $password );

    GetOptions(
        'h|help'      => \$isHelp,
        'v|verbose=i' => \$isVerbose,
        'envpath=s'   => \$envPath,
        'version=s'   => \$version,
        'buildno=s'   => \$buildNo,
        'lang=s'      => \$lang,
        'repotype=s'  => \$repoType,
        'startpath=s' => \$startPath,
        'user=s'      => \$userName,
        'password=s'  => \$password
    );

    usage() if ( defined($isHelp) );

    if ( defined($lang) ) {
        $ENV{LANG}   = $lang;
        $ENV{LC_ALL} = $lang;
    }

    my $deployUtils = DeployUtils->new();
    my $buildEnv    = $deployUtils->deployInit( $envPath, $version, $buildNo );

    $envPath = $buildEnv->{NAME_PATH};
    $version = $buildEnv->{VERSION};
    $buildNo = $buildEnv->{BUILD_NO};

    my $optionError = 0;
    if ( not defined($envPath) or $envPath eq '' ) {
        $optionError = 1;
        print("ERROR: EnvPath not defined by option --envpath or Environment:NAME_PATH\n");
    }
    if ( not defined($version) or $version eq '' ) {
        $optionError = 1;
        print("ERROR: Version not defined by option --version or Environment:VERSION\n");
    }
    if ( not defined($buildNo) or $buildNo eq '' ) {
        $optionError = 1;
        print("ERROR: Build number not defined by option --buildno or Environment:BUILD_NO\n");
    }
    if ( $optionError == 1 ) {
        usage();
    }

    my $namePath = $buildEnv->{NAME_PATH};

    my $serverAdapter = ServerAdapter->new();
    my $verInfo       = $serverAdapter->getVer($buildEnv);
    if (defined($startPath) and $startPath ne ''){
        $verInfo->{startPath} = $startPath;
    }
    if (defined($repoType) and $repoType ne ''){
        $verInfo->{repoType} = $repoType;
    }
    if ( not defined($verInfo) ) {
        print("ERROR: Can not find application $namePath version:$version.\n");
        return 3;
    }

    if ( defined($userName) and $userName ne '' ) {
        $verInfo->{username} = $userName;
    }
    if ( defined($password) and $password ne '' ) {
        $password = $deployUtils->decryptPwd($password);
        $verInfo->{password} = $password;
    }

    my $sourceBranch = $verInfo->{branch};
    if ( defined( $verInfo->{tag} ) and $verInfo->{tag} ne '' ) {
        if ( $verInfo->{repoType} eq 'svn' ) {
            $sourceBranch = $verInfo->{repo} . '/' . $verInfo->{tag};
        }
        else {
            $sourceBranch = $verInfo->{tag};
        }
    }

    my $lock        = DeployLock->new($buildEnv);
    my $spaceLockId = $lock->lockWorkspace($DeployLock::READ);

    END {
        local $?;
        if ( defined($lock) ) {
            $lock->unlockWorkspace($spaceLockId);
        }
    }

    my $prjPath    = $buildEnv->{PRJ_PATH};
    my $outputPath = $buildEnv->{VER_ROOT} . '/diff.json';

    if ( not -e $prjPath ) {
        print("ERROR: Project path:$prjPath not exists.\n");
        return 2;
    }

    my $toolsPath = $buildEnv->{TOOLS_PATH};
    my $javaHome = $ENV{JAVA_HOME};
    if ( defined($javaHome) and $javaHome ne '' and -x "$javaHome/bin/java" ) {
        $ENV{PATH} = "$javaHome/bin:" . $ENV{PATH};
    }
    elsif ( -f "$toolsPath/jdk/bin/java" ) {
        $ENV{JAVA_HOME} = "$toolsPath/jdk";
        $ENV{PATH}      = "$toolsPath/jdk/bin:" . $ENV{PATH};
    }
    else{
        print("ERROR: JDK not found in $toolsPath/jdk.\n");
    }

    my $libPath = $FindBin::Bin . '/lib/neatlogic-diff-1.0-jar-with-dependencies.jar';
    if ( not -f $libPath ) {
        print("ERROR: Code analyze library file $libPath not exists.\n");
        return 3;
    }

#result = subprocess.run([java_path, '-jar', libPath, '--type', args.repotype, '--path', project_path, '--url', args.repo, '--username',args.user, '--password', args.password, '--sourceBranch', args.branch, '--targetBranch', args.trunk, '--output', output_path, '--verbose', args.verbose], stderr=subprocess.STDOUT)

    my @cmds = ( 'java', '-jar', $libPath, '--type', $verInfo->{repoType}, '--path', $prjPath, '--url', $verInfo->{repo}, '--username', $userName, '--password', $password, '--sourceBranch', $sourceBranch, '--targetBranch', $verInfo->{trunk}, '--output', $outputPath, '--verbose', $isVerbose );
    my $cmd  = '';
    foreach my $cmdOpt (@cmds) {
        $cmd = $cmd . "'$cmdOpt' ";
    }
    my $hasError = DeployUtils->execmd($cmd);

    if ( $hasError == 0 ) {
        eval {
            my $fh = IO::File->new("<$outputPath");
            if ( defined($fh) ) {
                my $fSize = -s $outputPath;
                my $content;
                $fh->read( $content, $fSize );
                my $data = from_json($content);

                delete( $data->{fileDiffList} );
                $data->{version}     = $buildEnv->{VERSION};
                $data->{appSystemId} = $buildEnv->{SYS_ID};
                $data->{appModuleId} = $buildEnv->{MODULE_ID};
                $data->{repo}        = $verInfo->{repo};
                $data->{type}        = $verInfo->{repoType};
                if ( $data->{type} eq 'git' ) {
                    $data->{type} = 'gitlab';
                }
                $data->{user}     = $userName;
                $data->{password} = $deployUtils->encryptPwd($password);
                $serverAdapter->saveVersionMetrics($data);
                $fh->close();
            }
            else {
                $hasError = 3;
                print("ERROR: Code analyze result file:$outputPath not exists.\n");
            }
        };
        if ($@) {
            print( $@, "\n" );
            $hasError = 4;
            my $msg = $@;
            $msg =~ s/ at .*?$//;
            print($msg);
        }
    }

    if ( $hasError > 255 ) {
        $hasError = $hasError >> 8;
    }

    return $hasError;
}

exit main();
