                    {
                        "text": "jdk1.8",
                        "value": "jdk1.8"
                    },
                    {
                        "text": "jdk1.7",
                        "value": "jdk1.7"
                    },
                    {
                        "text": "jdk1.6",
                        "value": "jdk1.6"
                    },
                    {
                        "text": "jdk1.5",
                        "value": "jdk1.5"
                    }
                ]
            },
            "defaultValue": ""
        },
        {
            "opt": "args",
            "name": "Custom Arguments",
            "help": "Custom parameters for the compilation tool (e.g. parameters for ant or mvn)",
            "type": "text",
            "required": "false",
            "validate": "",
            "defaultValue": ""
        },
        {
            "opt": "startpath",
