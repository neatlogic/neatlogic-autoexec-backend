            "required": "true",
            "validate": "",
            "dataSource": {
                "dataList": [
                    {
                        "text": "Yes",
                        "value": "1"
                    },
                    {
                        "text": "No",
                        "value": "0"
                    }
                ]
            },
            "defaultValue": "0"
        },
        {
            "opt": "libpaths",
            "name": "Lib Directory",
            "help": "For example: target/webapp/WEB-INF/lib,*/target/webapp/WEB-INF/lib",
            "type": "text",
            "required": "true",
            "validate": "",
            "defaultValue": "target/webapp/WEB-INF/lib"
        },
        {
            "opt": "addlibtoclasspath",
            "name": "Add lib to CLASSPATH",
            "help": "Add all jars in the lib directory to CLASSPATH",
            "type": "select",
            "required": "true",
            "validate": "",
            "dataSource": {
                "dataList": [
                    {
                        "text": "Yes",
                        "value": "1"
                    },
                    {
                        "text": "No",
                        "value": "0"
                    }
                ]
            },
            "defaultValue": "0"
        },
        {
            "opt": "srcpaths",
            "name": "Java Code Directory",
            "help": "For example: src,*/src",
            "type": "text",
            "required": "true",
            "validate": "",
            "defaultValue": "src"
        },
        {
            "opt": "cmpoutpaths",
            "name": "Compile Output Directory",
            "help": "For example: target/webapp/WEB-INF/classes,*/target/webapp/WEB-INF/classes",
            "type": "text",
            "required": "true",
            "validate": "",
            "defaultValue": "target/webapp/WEB-INF/classes"
        },
        {
            "opt": "reservepaths",
            "name": "Other requirements directory",
            "help": "Other catalogues needed for the success of the build, e.g., target/webapp/WEB-INF/web.xml,*/target/webapp/WEB-INF/web.xml",
            "type": "text",
            "required": "false",
            "validate": "",
            "defaultValue": "target/webapp/WEB-INF/web.xml"
        },
        {
            "opt": "classpaths",
            "name": "CLASSPATH",
            "help": "The project needs to be added to the CLASSPATH directory, e. g. statusclasses,*/staticclasses",
            "type": "text",
            "required": "false",
            "validate": "",
            "defaultValue": "staticclasses"
        },
        {
            "opt": "islib",
            "name": "Whether submodules",
            "help": "The currently acquired code repository is a submodule for the joint compilation of multiple code repositories",
            "type": "select",
            "required": "false",
            "validate": "",
            "dataSource": {
                "dataList": [
                    {
                        "text": "No",
                        "value": "0"
                    },
                    {
                        "text": "Yes",
                        "value": "1"
                    }
                ]
            },
            "defaultValue": "0"
        }
