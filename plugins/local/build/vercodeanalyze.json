{
    "opDesc": "版本代码变更分析",
    "opType": "runner",
    "typeName": "BUILD",
    "riskName": "LOW",
    "interpreter": "python",
    "defaultProfile": "git-args",
    "description": "版本代码变更分析，对GIT/SVN代码进行diff",
    "enabled": 1,
    "option": [
        {
            "opt": "user",
            "name": "用户名",
            "help": "访问仓库的用户名(如GIT使用ssh方式，留空)",
            "type": "text",
            "required": "false",
            "validate": "",
            "defaultValue": "${global:git.user}"
        },
        {
            "opt": "password",
            "name": "密码",
            "help": "访问仓库的密码(如GIT使用ssh方式，留空)",
            "type": "password",
            "required": "false",
            "validate": "",
            "defaultValue": "${global:git.password}"
        }
    ],
    "output": []
}