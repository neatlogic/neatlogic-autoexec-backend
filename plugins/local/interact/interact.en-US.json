            "required": "true",
            "validate": "",
            "dataSource": {
                "dataList": [
                    {
                        "text": "button",
                        "value": "button"
                    },
                    {
                        "text": "Drop-down selection",
                        "value": "select"
                    },
                    {
                        "text": "Dropdown Multiple Choices",
                        "value": "mselect"
                    },
                    {
                        "text": "Input",
                        "value": "input"
                    }
                ]
            },
