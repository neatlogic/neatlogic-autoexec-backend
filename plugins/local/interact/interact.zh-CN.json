{
    "opDesc": "执行交互工具",
    "opType": "runner",
    "typeName": "BASIC",
    "riskName": "LOW",
    "interpreter": "perl",
    "defaultProfile": "interact-args",
    "description": "执行过程中获取用户输入",
    "enable": 0,
    "option": [
        {
            "opt": "optype",
            "name": "交互类型",
            "help": "选择交互的类型",
            "type": "select",
            "required": "true",
            "validate": "",
            "dataSource": {
                "dataList": [
                    {
                        "text": "按钮",
                        "value": "button"
                    },
                    {
                        "text": "下拉选择",
                        "value": "select"
                    },
                    {
                        "text": "下拉多项选择",
                        "value": "mselect"
                    },
                    {
                        "text": "输入",
                        "value": "input"
                    }
                ]
            },
            "defaultValue": "button"
        },
        {
            "opt": "optionsjson",
            "name": "输入选项",
            "help": "输入选项的JSON数组，例如：[\"Yes\",\"No\"], 如果输入类型是input，则设置为[]",
            "type": "json",
            "required": "true",
            "validate": "",
            "defaultValue": "[\"Yes\",\"No\"]"
        },
        {
            "opt": "role",
            "name": "操作角色",
            "help": "允许操作的角色",
            "type": "text",
            "required": "false",
            "validate": "",
            "defaultValue": ""
        },
        {
            "opt": "title",
            "name": "标题",
            "help": "交互标题",
            "type": "text",
            "required": "true",
            "validate": "",
            "defaultValue": "请选择"
        },
        {
            "opt": "message",
            "name": "交互说明",
            "help": "交互主体中显示的说明文案",
            "type": "text",
            "required": "true",
            "validate": "",
            "defaultValue": "是否继续执行？"
        }
    ],
    "output": [
        {
            "opt": "interactOut",
            "name": "交互结果",
            "help": "交互输入的结果",
            "type": "text"
        }
    ]
}