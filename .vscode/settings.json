{
    "python.envFile": "${workspaceFolder}/.vscode/.env",
    "perltidy.profile": "${workspaceFolder}/.vscode/.perltidyrc",
    "perl.perlInc": [
        ".",
        "${workspaceFolder}/plugins/remote/wastool/bin",
        "${workspaceFolder}/plugins/local/build/lib",
        "${workspaceFolder}/plugins/local/deploy/lib",
        "${workspaceFolder}/plugins/local/pllib/lib/perl5",
        "${workspaceFolder}/plugins/local/lib",
        "${workspaceFolder}/plugins/remote/lib",
        "${workspaceFolder}/plugins/remote/cmdbcollect/lib"
    ],
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.rulers": [
            88
        ],
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports.ruff": "explicit"
        },
        "ruff.args": [
            "--ignore=E501"
        ]
    }
}